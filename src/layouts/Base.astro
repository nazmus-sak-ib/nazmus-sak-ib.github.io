---
import '../styles/global.css';
import { entry } from '../lib/content';
const {title='Nazmus Sakib', description='Research, transportation, and practical computational work.'}=Astro.props;
const profile = entry('profile').frontmatter;
const settings=entry('site').frontmatter;
const nav=settings.navigation;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title} · Nazmus Sakib</title><link rel="icon" href="/favicon.svg"/></head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="header"><a class="brand" href="/">{profile.name}<span>{profile.brandSubtitle}</span></a><nav aria-label="Main navigation">{nav.map(({href,label})=><a href={href} aria-current={href.includes('#')?undefined:(href==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(href))?'page':undefined}>{label}</a>)}</nav></header>
<main id="main"><slot/></main>
<footer id="contact"><div><strong>{settings.footerTitle}</strong><p>{settings.footerText}</p><a href={'mailto:'+profile.email}>{profile.email}</a></div><div class="footer-links"><a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}>GitHub ↗</a><span>{settings.location}</span></div><small>{settings.draftNote}</small></footer>
</body></html>