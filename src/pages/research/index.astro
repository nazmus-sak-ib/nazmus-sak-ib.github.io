---
import Base from '../../layouts/Base.astro';
import {entry,items} from '../../lib/content';
const projects=items('projects'); const info=entry('work').frontmatter;
const tags=entry('work').frontmatter.filters;
const dateValue=p=>Date.parse(p.frontmatter.sortDate??String(p.frontmatter.year)+'-01-01')||0;
const latest=[...projects].sort((a,b)=>dateValue(b)-dateValue(a)||a.frontmatter.title.localeCompare(b.frontmatter.title));
---
<Base title={info.title}><section class="page-head work-page-head"><h1>{info.title}</h1><p>{info.intro}</p></section><section class="section work-library"><div class="work-controls" hidden><fieldset class="tag-filters"><legend>Filter by context or type</legend><button type="button" data-tag="" aria-pressed="true">All</button>{tags.map(tag=><button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}</fieldset><label class="sort-control">Sort <select id="work-sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="shuffle">Shuffle</option></select></label></div><p id="work-count" role="status" aria-live="polite">{projects.length} projects</p><div id="work-grid" class="work-grid">{latest.map(p=><article class:list={["work-card", {"spotlight":p.frontmatter.spotlight}]} data-tags={JSON.stringify(p.frontmatter.tags??[])} data-date={dateValue(p)}><a class="work-card-link" href={'/research/'+p.slug+'/'}><div class="work-tags card-top-tags">{(p.frontmatter.tags??[]).map(tag=><span>{tag}</span>)}</div>{p.frontmatter.image?<img class="work-thumb" src={p.frontmatter.image} alt={p.frontmatter.imageAlt??''} loading="lazy"/>:<div class="work-thumb thumbnail-placeholder"><span>Image placeholder</span><strong>{p.frontmatter.placeholder??p.frontmatter.title}</strong></div>}<div class="work-card-body"><span class="badge">{p.frontmatter.status}</span><p class="card-date">{p.frontmatter.dateLabel}</p><h2>{p.frontmatter.title}</h2><p>{p.frontmatter.summary}</p>{p.frontmatter.highlights?.length>0 && <ul class="project-highlights compact">{p.frontmatter.highlights.map(point=><li>{point}</li>)}</ul>}<span class="text-link">View project →</span></div></a></article>)}</div><p id="work-empty" hidden>No projects match these filters. Choose All to reset.</p></section></Base>
<script>
const grid=document.querySelector<HTMLDivElement>('#work-grid');
if(grid){
 const cards=Array.from(grid.querySelectorAll<HTMLElement>('.work-card'));
 const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag]'));
 let selected='';
 const sort=document.querySelector<HTMLSelectElement>('#work-sort')!;
 function update(){
  let ordered=[...cards];
  if(sort.value==='shuffle'){for(let i=ordered.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[ordered[i],ordered[j]]=[ordered[j],ordered[i]];}}
  else ordered.sort((a,b)=>(Number(a.dataset.date)-Number(b.dataset.date))*(sort.value==='oldest'?1:-1));
  let count=0;
  for(const card of ordered){const tags=JSON.parse(card.dataset.tags!);card.hidden=Boolean(selected)&&!tags.includes(selected);if(!card.hidden)count++;grid!.append(card);}
  buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.tag?selected===b.dataset.tag:selected==='')));
  document.querySelector('#work-count')!.textContent=count+' of '+cards.length+' projects';
  (document.querySelector('#work-empty') as HTMLElement).hidden=count>0;
 }
 buttons.forEach(b=>b.addEventListener('click',()=>{const tag=b.dataset.tag!;selected=selected===tag?'':tag;update();}));
 sort.addEventListener('change',update);
 (document.querySelector('.work-controls') as HTMLElement).hidden=false;
 update();
}
</script>