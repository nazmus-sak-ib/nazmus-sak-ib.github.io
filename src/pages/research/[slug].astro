---
import Base from '../../layouts/Base.astro';
import SurveyProject from '../../components/SurveyProject.astro';
import LabProject from '../../components/LabProject.astro';
import UndergraduateThesis from '../../components/UndergraduateThesis.astro';
import {entry,items} from '../../lib/content';
export function getStaticPaths(){return items('projects').map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props; const {Content,frontmatter:info}=project;
const fullText=info.fullText?entry(info.fullText):null;
const FullText=fullText?.Content;
const related=items('projects').filter(p=>(info.relatedProjects??[]).includes(p.slug));
const contexts=['experiences','education'].flatMap(section=>items(section).filter(r=>(r.frontmatter.relatedProjects??[]).includes(project.slug)).map(r=>({record:r,kind:section==='education'?'education':'experience'})));
---
<Base title={info.title} description={info.summary}><section class="page-head"><a class="text-link" href="/research/">← Selected work</a><p class="eyebrow">{info.status}</p><h1>{info.title}</h1><p>{info.summary}</p>{info.highlights?.length>0 && <ul class="project-highlights">{info.highlights.map(point=><li>{point}</li>)}</ul>}{info.review && <p class="review">Draft note: {info.review}</p>}</section>{info.scenarios?.length>0 && <section class="section scenario-section" aria-labelledby="scenario-title"><h2 id="scenario-title">Four scenarios, one travel sample</h2><p>Simulated share of active vehicle-days infeasible without DC fast charging. Each scenario includes its stated starting-charge assumptions.</p><div class="scenario-grid">{info.scenarios.map(s=><article><h3>{s.label}</h3><strong>{s.rate}</strong><p>{s.assumption}</p></article>)}</div></section>}{info.specialLayout==='survey' && <SurveyProject project={project}/>}{info.specialLayout==='transportation-lab' && <LabProject/>}{info.specialLayout==='undergraduate-thesis' && <UndergraduateThesis/>}<article class="prose section">{!info.specialLayout && info.image && <img class="project-image" src={info.image} alt={info.imageAlt??''}/>}{!info.specialLayout && <Content/>}{FullText && <details class="full-article"><summary>Read the original course essay, including references</summary><div class="archival-text"><FullText/></div></details>}{related.length>0 && <aside class="project-context"><h2>Related work</h2><ul>{related.map(p=><li><a href={'/research/'+p.slug+'/'}>{p.frontmatter.title} →</a></li>)}</ul></aside>}{contexts.length>0 && <aside class="project-context"><h2>Related education & experience</h2><ul>{contexts.map(({record,kind})=><li><a href={'/#timeline-'+kind+'-'+record.slug}>{record.frontmatter.title} · {record.frontmatter.organization} →</a></li>)}</ul></aside>}</article></Base>