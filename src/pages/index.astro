---
import Base from '../layouts/Base.astro';
import {entry,items} from '../lib/content';
const profile=entry('profile'); const {Content}=profile; const info=profile.frontmatter;
const projects=items('projects').filter(p=>p.frontmatter.featured);
---
<Base title="Home"><section class="hero"><div><p class="eyebrow">{info.topics}</p><h1>{info.headline}<br/><em>{info.headlineAccent}</em></h1><div class="intro"><Content/></div><div class="actions"><a class="button" href="/research/uvm-survey/">Explore my research <span>↗</span></a><a class="text-link" href="/experience/">Follow my experience →</a></div></div><aside class="portrait"><div class="portrait-inner">{profile.frontmatter.portrait ? <img src={profile.frontmatter.portrait} alt={profile.frontmatter.portraitAlt}/> : <><span class="monogram">NS</span><span>Your photograph will go here</span></>}</div><p>{info.portraitCaption} <span>{info.portraitCaptionDetail}</span></p></aside></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">Current focus</p><h2>Understanding how we move.</h2></div><a class="text-link" href="/research/">All selected work →</a></div>{projects.map(p=><a class="feature" href={'/research/'+p.slug+'/'}><div><span class="badge">{p.frontmatter.status}</span><h3>{p.frontmatter.title}</h3><p>{p.frontmatter.summary}</p><span class="text-link">Explore the project →</span></div><div class="feature-art" aria-hidden="true"><span>People</span><span>Place</span><span>Behavior</span><small>Survey design → Behavioral modeling</small></div></a>)}</section>
<section class="section"><p class="eyebrow">A connected practice</p><h2>Different settings. A practical approach.</h2><div class="grid three"><article class="card"><span class="number">01</span><h3>Design the inquiry</h3><p>Translate literature and research questions into survey instruments and fieldwork.</p></article><article class="card"><span class="number">02</span><h3>Work with the data</h3><p>Develop analytical and computational workflows around the question at hand.</p></article><article class="card"><span class="number">03</span><h3>Make it understandable</h3><p>Bring experience in teaching, field research, and development studies to technical work.</p></article></div></section></Base>