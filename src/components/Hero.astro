---
import {entry,items} from '../lib/content';
const profile=entry('profile'); const {Content}=profile; const info=profile.frontmatter;
const home=entry('home').frontmatter;
const featured=items('projects').find(p=>p.frontmatter.featured);
---
<section class="hero"><div><p class="eyebrow">{info.topics}</p><h1>{info.headline}<br/><em>{info.headlineAccent}</em></h1><div class="intro"><Content/></div><div class="actions">{featured && <a class="button" href={'/research/'+featured.slug+'/'}>{home.researchButton} <span>↗</span></a>}<a class="text-link" href="#timeline">{home.experienceButton} →</a></div></div><aside class="portrait"><div class="portrait-inner">{info.portrait ? <img src={info.portrait} alt={info.portraitAlt}/> : <><span class="monogram">NS</span><span>Your photograph will go here</span></>}</div><p>{info.portraitCaption} <span>{info.portraitCaptionDetail}</span></p></aside></section>